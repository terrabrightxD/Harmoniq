<Window x:Class="CrateScope.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CrateScope" Title="CrateScope" Width="1220" Height="860" MinWidth="1000" MinHeight="740" Background="#F5F6F8" FontFamily="Segoe UI" FontSize="13" Foreground="#252B36" AllowDrop="True" Drop="OnDrop" WindowStartupLocation="CenterScreen">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border Background="#ECEEF3" BorderBrush="#E0E3E9" BorderThickness="0,0,1,0"><DockPanel Margin="22,32">
 <StackPanel DockPanel.Dock="Top"><TextBlock Text="◉  CrateScope" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="YOUR MUSIC, IN FOCUS" Foreground="#8A90A0" FontSize="9" Margin="2,8,0,40"/>
 <TextBlock Text="BIBLIOTHEK" Foreground="#8991A0" FontSize="10" Margin="8,0,0,12"/><Border Background="#DFE5F5" CornerRadius="8" Padding="12"><TextBlock Text="♫   Alle Tracks" Foreground="#485C9B" FontWeight="SemiBold"/></Border>
 <TextBlock x:Name="CountLabel" Text="0 Tracks" Foreground="#8A91A0" Margin="12,14,0,0"/></StackPanel>
 <StackPanel VerticalAlignment="Bottom"><TextBlock Text="LOCAL BY DESIGN" Foreground="#939BAB" FontSize="9"/><TextBlock Text="Deine Musik bleibt hier.&#10;Originaldateien bleiben unverändert." TextWrapping="Wrap" Foreground="#8991A0" FontSize="11" LineHeight="18" Margin="0,8,0,0"/></StackPanel>
 </DockPanel></Border>
 <Grid Grid.Column="1" Margin="32,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid><StackPanel><TextBlock Text="Deine Musik. Klarer." FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Tonart, Tempo und musikalische Orientierung." Foreground="#8991A0" Margin="0,6,0,0"/></StackPanel><Button x:Name="ImportButton" Content="＋  Musik hinzufügen" Click="Import" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#566BCE" Foreground="White"/></Grid>
 <Grid Grid.Row="1" Margin="0,24,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" TextChanged="Filter" ToolTip="Nach Track oder Tonart suchen"/><Button Grid.Column="1" Content="Exportieren ↗" Click="Export" Margin="12,0,0,0"/></Grid>
 <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E8EBEF" BorderThickness="1" Padding="1"><Grid><DataGrid x:Name="Tracks" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#FCFCFE" SelectionMode="Single" SelectionChanged="SelectTrack" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
 <DataGridTextColumn Header="TRACK" Binding="{Binding Name}" Width="*" MinWidth="160"/><DataGridTextColumn Header="TONART" Binding="{Binding Key}" Width="105"/><DataGridTextColumn Header="CAMELOT" Binding="{Binding Camelot}" Width="85"/><DataGridTextColumn Header="BPM" Binding="{Binding Bpm, StringFormat=F2}" Width="80"/><DataGridTextColumn Header="ENERGY" Binding="{Binding Energy, StringFormat=F1}" Width="80"/>
 </DataGrid.Columns></DataGrid><StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="♫" FontSize="42" Foreground="#B6BFDB" HorizontalAlignment="Center"/><TextBlock Text="Platz für deinen nächsten Set." FontSize="21" Margin="0,16,0,8"/><TextBlock Text="Audiodateien hierher ziehen oder oben hinzufügen." Foreground="#929AA9"/></StackPanel></Grid></Border>
 <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="20,16" Margin="0,18,0,0"><StackPanel>
 <Grid><TextBlock x:Name="TrackTitle" Text="Track auswählen" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="Evidence" HorizontalAlignment="Right" Foreground="#8B91A0" FontSize="11"/></Grid>
 <local:WaveView x:Name="Wave" Height="100" Margin="0,10,0,4"/>
 <TextBlock x:Name="Details" Text="Die Waveform und Cue-Vorschläge erscheinen nach der Analyse." Foreground="#8991A0" FontSize="11" TextWrapping="Wrap"/>
 <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="85"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="KeyEdit" VerticalContentAlignment="Center"/><TextBox x:Name="BpmEdit" Grid.Column="1" Margin="8,0" ToolTip="BPM"/><TextBox x:Name="CueEdit" Grid.Column="2" ToolTip="Cue-Zeiten in Sekunden, mit Semikolon getrennt"/><Button Grid.Column="3" Content="Korrigieren" Click="Correct" Margin="10,0,0,0"/></Grid>
 </StackPanel></Border>
 <StackPanel Grid.Row="4" Margin="0,15,0,0"><Grid><TextBlock x:Name="Status" Text="Bereit · WAV, MP3, FLAC und weitere Windows-Codecs" Foreground="#8A91A0" FontSize="11"/><TextBlock Text="CrateScope 0.2  /  Windows" HorizontalAlignment="Right" Foreground="#A0A6B2" FontSize="10"/></Grid><ProgressBar x:Name="Progress" Height="3" Margin="0,10,0,0" BorderThickness="0" Background="#E8EBF2" Foreground="#697BD4" Maximum="100"/></StackPanel>
 </Grid></Grid>
</Window>

